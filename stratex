    }
    print(json.dumps(status, indent=2, sort_keys=True))
    return 0


def cmd_lane_create(args: argparse.Namespace) -> int:
    data = load_lanes()
    lane = next((l for l in data.get("lanes") or [] if l.get("id") == args.lane_id), None)
    if not lane:
        print(f"Unknown lane: {args.lane_id}", file=sys.stderr)
        return 1
    wt = lane_worktree_path(args.lane_id)
    branch = f"lane/{args.lane_id.lower()}"
    plan = {
        "action": "create_lane_worktree",
        "lane_id": args.lane_id,
        "branch": branch,
        "worktree": str(wt),
        "dry_run": bool(args.dry_run),
        "confirm": bool(args.confirm),
        "push": False,
        "merge": False,
    }
    if args.dry_run:
        print(json.dumps({**plan, "status": "dry_run"}, indent=2, sort_keys=True))
        print("stratex: lane create dry-run only (no push/merge performed)")
        return 0

    if wt.exists() and not args.confirm:
        print(
            json.dumps(
                {
                    **plan,
                    "status": "blocked_worktree_collision",
                    "error": f"Worktree path exists: {wt}. Re-run with --confirm to proceed.",
                },
                indent=2,
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        return 2

    if not args.confirm:
        print(
            "Refusing to create worktree without --confirm (and use --dry-run to preview).",
            file=sys.stderr,
        )
        return 2

    # Create local worktree/branch only — never push/merge.
    if wt.exists():
        print(f"Using existing worktree path after --confirm: {wt}")
        print(json.dumps({**plan, "status": "confirmed_existing"}, indent=2, sort_keys=True))
        return 0

    proc = run_git("worktree", "add", "-b", branch, str(wt))
    if proc.returncode != 0:
        # Branch may already exist — try without -b
        proc2 = run_git("worktree", "add", str(wt), branch)
        if proc2.returncode != 0:
            print(proc.stderr or proc.stdout, file=sys.stderr)
            print(proc2.stderr or proc2.stdout, file=sys.stderr)
            return 1
    print(json.dumps({**plan, "status": "created"}, indent=2, sort_keys=True))
    print("stratex: lane create complete (no push/merge performed)")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="stratex",
        description="Stratex High-Velocity Engineering CLI (EF-001)",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    verify = sub.add_parser("verify", help="Run verification gates")
    verify.add_argument("--fast", action="store_true", help="Fast local verification")
    verify.add_argument("--full", action="store_true", help="Full verification including integration honesty")
    verify.add_argument("--architecture", action="store_true", help="Architecture boundary checks")
    verify.add_argument("--security", action="store_true", help="Security boundary checks")
    verify.set_defaults(func=cmd_verify)

    evidence = sub.add_parser("evidence", help="Generate redacted Atlas evidence package")
    evidence.add_argument("--base", default=None, help="Optional git base ref for changed-path inventory")
    evidence.set_defaults(func=cmd_evidence)

    lane = sub.add_parser("lane", help="Lane planning and worktree helpers")
    lane_sub = lane.add_subparsers(dest="lane_command", required=True)

    lane_list = lane_sub.add_parser("list", help="List lanes")
    lane_list.set_defaults(func=cmd_lane_list)

    lane_plan = lane_sub.add_parser("plan", help="Show lane plan JSON")
    lane_plan.add_argument("lane_id")
    lane_plan.set_defaults(func=cmd_lane_plan)

    lane_status = lane_sub.add_parser("status", help="Show lane status")
    lane_status.add_argument("lane_id")
    lane_status.set_defaults(func=cmd_lane_status)

    lane_create = lane_sub.add_parser("create", help="Create lane worktree (never pushes/merges)")
    lane_create.add_argument("lane_id")
    lane_create.add_argument("--dry-run", action="store_true")
    lane_create.add_argument("--confirm", action="store_true")
    lane_create.set_defaults(func=cmd_lane_create)

    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    sys.exit(main())

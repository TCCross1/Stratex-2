# RT-001 integration environment — SAFE PLACEHOLDERS ONLY
# Copy to .rt001/secrets.env via generate_local_secrets.sh (gitignored).
# Do NOT commit real credentials. Production readiness: NOT READY.
# Base SHA: 0c09b0cf44fb133852ddbb9ce96cea2e137ade6d

# --- Mongo (replica set via docker-compose) ---
RT001_MONGO_PORT=27018
# Host-side URL uses localhost + published port. Inside compose, use mongo1:27017.
MONGO_URL=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
DB_NAME=stratex_rt001
RT001_MONGO_REPLICA_SET=rs0

# --- MinIO / S3-compatible object storage ---
RT001_MINIO_API_PORT=9000
RT001_MINIO_CONSOLE_PORT=9001
RT001_MINIO_ROOT_USER=rt001minio
RT001_MINIO_ROOT_PASSWORD=rt001minio-change-me
RT001_MINIO_BUCKET=stratex-rt001
RT001_S3_ENDPOINT=http://127.0.0.1:9000
RT001_S3_ACCESS_KEY=rt001minio
RT001_S3_SECRET_KEY=rt001minio-change-me
RT001_S3_BUCKET=stratex-rt001
RT001_S3_REGION=us-east-1

# --- Local disk adapter fallback (always available without Docker) ---
NEXTGEN_STORAGE_ROOT=.rt001/nextgen_storage

# --- Honesty / readiness ---
RT001_PRODUCTION_READY=false

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stratex://contracts/EvidenceManifest/0.0.0",
  "title": "EvidenceManifest",
  "description": "ATC-001A field-capture evidence inventory. PROPOSED / READY_FOR_FREEZE. No Passport acceptance claim. No fabricated live device evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "mission_type",
    "aircraft_profile_id",
    "package_hash",
    "artifacts",
    "atc_validation_status",
    "passport_accepted",
    "provenance",
    "confidence",
    "unknown_state",
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["contract_name", "contract_version", "lifecycle_status", "approval_authority"],
      "properties": {
        "contract_name": { "const": "EvidenceManifest" },
        "contract_version": { "const": "0.0.0" },
        "lifecycle_status": { "enum": ["PROPOSED", "READY_FOR_FREEZE"] },
        "approval_authority": { "const": "Atlas" },
        "owning_lane": { "const": "LANE_2_ATC_FIELD" }
      }
    },
    "mission_id": { "type": "string", "minLength": 1 },
    "mission_type": {
      "enum": ["DAYTIME_PRECISION_MAPPING", "NIGHTTIME_AWE_VISUAL_THERMAL"]
    },
    "aircraft_profile_id": {
      "enum": ["M4E_MAPPING", "M4T_AWE", "M400_P1_MAPPING", "M400_H30T_AWE"]
    },
    "package_hash": { "type": "string", "minLength": 8 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "category", "relative_path", "required", "present"],
        "properties": {
          "artifact_id": { "type": "string" },
          "category": { "type": "string" },
          "relative_path": { "type": "string" },
          "content_sha256": { "type": ["string", "null"] },
          "required": { "type": "boolean" },
          "present": { "type": "boolean" }
        }
      }
    },
    "completeness_ok": { "type": "boolean" },
    "atc_validation_status": {
      "enum": ["NOT_VALIDATED", "VALIDATED_CANDIDATE", "BLOCKED"]
    },
    "passport_accepted": { "const": false },
    "provenance": { "type": "object" },
    "confidence": { "type": "object" },
    "unknown_state": { "type": "object" }
  }
}
